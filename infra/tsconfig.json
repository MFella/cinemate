{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2022",
    "lib": ["es2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "../dist/out-tsc/infra",
    "types": ["node"],
    "ignoreDeprecations": "6.0"
  },
  "include": ["bin/**/*.ts", "lib/**/*.ts"]
}
